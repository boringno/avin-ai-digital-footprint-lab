# Per-client production credentials. Never commit real values or share them in chat/email.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# AI provider. Set exactly one provider credential below for the selected provider.
AI_PROVIDER=openai
CLAUDE_API_ENABLED=false
CLAUDE_HUMANIZER_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_TOKENS=300

# Optional per-client monitoring. Do not add SENTRY_AUTH_TOKEN unless source-map upload is configured.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional transitional reporting export. The database remains the source of truth.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Production safety flags. Keep signature verification enabled for every real LINE channel.
LIVE_DEMO_SEND_REPLY=false
LIVE_DEMO_SKIP_SIGNATURE_VERIFY=false
LIVE_DEMO_INCLUDE_PENDING=false
LINE_REPLY_TIMEOUT_MS=8000
LINE_REPLY_RETRY_COUNT=1

# Per-client notification and deployment routing.
LIVE_DEMO_ALERT_LINE_USER_ID=
ADMIN_NOTIFY_TARGET=
APP_BASE_URL=https://line-ai-live-demo.vercel.app
LIVE_DEMO_SEED_DIR=./data/live-demo-seed
LIVE_DEMO_LOG_DIR=./runtime-logs
LIVE_DEMO_DEBUG_TOKEN=

# Per-client Supabase project. Service-role access is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_OWNER_EMAIL=

# Per-client scheduled reporting secret. Generate a unique random value of at least 32 characters.
CRON_SECRET=
