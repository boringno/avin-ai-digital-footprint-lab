# Per-client production credentials. Never commit real values or share them in chat/email.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# AI provider. Set exactly one provider credential below for the selected provider.
AI_PROVIDER=openai
CLAUDE_API_ENABLED=false
CLAUDE_HUMANIZER_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_TOKENS=300
# Bounds the optional reply generator after deterministic routing/classification.
AI_REPLY_GENERATION_TIMEOUT_MS=2500
AI_OFFICIAL_SEARCH_TIMEOUT_MS=5500
# Optional controlled classifier. It only classifies intent; it never writes the reply.
OPENAI_INTENT_CLASSIFIER_ENABLED=true
OPENAI_INTENT_CLASSIFIER_MIN_CONFIDENCE=0.85
OPENAI_INTENT_CLASSIFIER_MAX_TOKENS=96
# NLU observation and customer-visible canary are separate, default-off gates.
# Keep OPENAI_NLU_DECISION_MODE=off until golden eval approval; only "canary" is supported after approval.
OPENAI_NLU_MODE=off
OPENAI_NLU_DECISION_MODE=off
OPENAI_NLU_SAMPLE_RATE=0
OPENAI_NLU_TIMEOUT_MS=700
# Conversation V2 uses captured NLU frames only for internal replay and comparison.
# It never changes a customer reply while this value is "off" or "shadow".
CONVERSATION_V2_MODE=off

# Optional per-client monitoring. Do not add SENTRY_AUTH_TOKEN unless source-map upload is configured.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional transitional reporting export. The database remains the source of truth.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Production safety flags. Keep signature verification enabled for every real LINE channel.
LIVE_DEMO_SEND_REPLY=false
LIVE_DEMO_SKIP_SIGNATURE_VERIFY=false
LIVE_DEMO_INCLUDE_PENDING=false
LINE_REPLY_TIMEOUT_MS=8000
LINE_REPLY_RETRY_COUNT=1

# Per-client notification and deployment routing.
LIVE_DEMO_ALERT_LINE_USER_ID=
# Internal handoff notifications are group-only. Use a LINE C... group ID;
# customer U... and room R... IDs are rejected by the application.
ADMIN_NOTIFY_TARGET=
APP_BASE_URL=https://line-ai-live-demo.vercel.app
LIVE_DEMO_SEED_DIR=./data/live-demo-seed
LIVE_DEMO_LOG_DIR=./runtime-logs
LIVE_DEMO_DEBUG_TOKEN=

# Per-client Supabase project. Service-role access is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_OWNER_EMAIL=

# Per-client scheduled reporting secret. Generate a unique random value of at least 32 characters.
CRON_SECRET=

# Optional handoff digest email. Configure these only in Vercel Production.
# Verify the sender domain with the email provider first. Leave recipients blank to disable each branch.
RESEND_API_KEY=
HANDOFF_DIGEST_FROM=
HANDOFF_DIGEST_KAOHSIUNG_TO=
HANDOFF_DIGEST_TAICHUNG_TO=
HANDOFF_DIGEST_TAOYUAN_TO=
HANDOFF_DIGEST_LINKOU_TO=

# Retention sweep apply gate. Leave unset (dry-run: scan and count only, never delete or write audit_logs).
# Set to "apply" only after owner has reviewed at least a week of dry-run counts. See docs/DEPLOYMENT_CHECKLIST.md.
# RETENTION_SWEEP_MODE=apply
